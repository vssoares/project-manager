{
  "name": "project-manager",
  "private": true,
  "version": "1.0.18",
  "description": "Gerencie múltiplas versões e ambientes de arquivos de configuração (.env e outros) e automatize o fluxo de hotfix/branches do Git Flow, com histórico, comparação e execução de comandos Git.",
  "author": "vssoares",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"npm:dev:vite\" \"npm run dev:wait\"",
    "dev:wait": "wait-on tcp:5173 && node scripts/build-electron.mjs && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "dist:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:win:publish": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --publish always",
    "lint": "oxlint",
    "icons": "node scripts/generate-app-icon.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "diff": "^9.0.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "monaco-editor": "^0.56.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@angular-devkit/build-angular": "^21.2.20",
    "@angular/build": "^21.2.20",
    "@angular/compiler-cli": "^21.2.19",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.13.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.projectmanager.app",
    "productName": "Project Manager",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "hf.ps1",
        "to": "hf.ps1"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "ProjectManager-Setup-${version}.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "vssoares",
      "repo": "project-manager",
      "releaseType": "release"
    }
  }
}
